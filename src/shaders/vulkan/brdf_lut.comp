#version 460
#extension GL_GOOGLE_include_directive : require
// Split-sum BRDF lookup table: x = NdotV, y = roughness -> (scale, bias) of F0.
#include "brdf.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 1, rg16f) uniform writeonly image2D uOut;

void main()
{
	ivec2 id = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(uOut);
	if (id.x >= size.x || id.y >= size.y) return;
	float NdotV = max((float(id.x) + 0.5) / float(size.x), 1e-3);
	float roughness = (float(id.y) + 0.5) / float(size.y);
	float a = roughness * roughness;
	vec3 V = vec3(sqrt(1.0 - NdotV * NdotV), 0.0, NdotV);
	vec2 r = vec2(0.0);
	const uint N = 512u;
	for (uint i = 0u; i < N; ++i)
	{
		vec3 H = ImportanceSampleGGX(Hammersley(i, N), vec3(0.0, 0.0, 1.0), a);
		vec3 L = reflect(-V, H);
		float NdotL = L.z, NdotH = max(H.z, 0.0), VdotH = max(dot(V, H), 0.0);
		if (NdotL <= 0.0) continue;
		float vis = V_SmithGGXCorrelated(NdotV, NdotL, a) * VdotH * NdotL / max(NdotH, 1e-5);
		float fc = pow(1.0 - VdotH, 5.0);
		r += vec2(1.0 - fc, fc) * vis * 4.0;
	}
	imageStore(uOut, id, vec4(r / float(N), 0.0, 0.0));
}
